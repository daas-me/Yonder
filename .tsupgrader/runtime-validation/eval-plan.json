{
  "projectType": "webapp",
  "setup": [
    {
      "command": "corepack",
      "args": ["pnpm", "install", "--frozen-lockfile"],
      "cwd": "frontend",
      "timeoutSeconds": 600
    }
  ],
  "assertions": [
    {
      "name": "typecheck",
      "kind": "process",
      "command": "npm",
      "args": ["run", "typecheck"],
      "verificationMethod": "exit-code",
      "expected": "0",
      "timeoutSeconds": 180
    },
    {
      "name": "tests-pass",
      "kind": "process",
      "command": "npm",
      "args": ["test"],
      "verificationMethod": "test-results",
      "expected": "0",
      "timeoutSeconds": 300
    },
    {
      "name": "production-build",
      "kind": "process",
      "command": "npm",
      "args": ["run", "build"],
      "verificationMethod": "exit-code",
      "expected": "0",
      "timeoutSeconds": 300
    },
    {
      "name": "dev-server-serves-home",
      "kind": "http-probe",
      "startCommand": "npm",
      "startArgs": ["run", "dev"],
      "env": {
        "PORT": "8444"
      },
      "url": "http://localhost:8444/",
      "verificationMethod": "http-status",
      "expected": "200",
      "timeoutSeconds": 120
    }
  ]
}
